---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import WorkCard from '../components/WorkCard.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---
<Base page="work" title="Work" description="Explore selected StudioHue projects across branding, web design, Webflow, UX, product design, and digital experiences created for ambitious businesses.">
  <div class="page-wrapper">
    <div class="hero-area">
      <Header />
      <section class="section">
        <div class="section-gap bottom-6xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="work-hero-header">
              <div class="work-hero-left">
                <div class="inner-badge">
                  <div class="badge-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon">
                      <rect x="5" width="2" height="12" fill="currentColor"></rect>
                      <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                      <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                      <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                    </svg></div>
                  <div class="badge-text">OUR WORK</div>
                </div>
                <div class="hero-heading-wrap">
                  <h1 class="hero-heading">Digital Experiences That <span class="hiighlight-heading">Create Lasting Impact</span></h1>
                </div>
              </div>
              <div class="inner-hero-right">
                <div class="work-year">2023–2026</div>
              </div>
            </div>
            <div class="work-button-wrap">
              <a href="/contact" data-wf--primary-button--variant="base" data-wf-component-id="fe6f4be6-50ca-05e1-38e9-9a6e9da8d773" data-wf-variant-state="base" class="primary-button w-inline-block">
                <div class="button-dot">
                  <div class="animated-dot"></div>
                </div>
                <div class="button-text-wrap">
                  <div class="footer-link-text">Start Your Project</div>
                  <div class="footer-link-text is-two">Start Your Project</div>
                </div>
              </a>
              <div class="work-summary-wrap">
                <p class="inner-hero-summary">Discover our strategic, creative branding and digital projects designed for ambitious businesses with real results.</p>
              </div>
            </div>
            <div class="work-collection-wrap">
              <div class="w-dyn-list">
                <div role="list" class="work-collection-list w-dyn-items">
                  {projects.map((project) => (
                    <div role="listitem" class="w-dyn-item">
                      <WorkCard project={project} />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
    <div class="main">
      <Cta />
    </div>
    <Footer page="work" />
  </div>
</Base>
