                  <div class="font-large">Craft at scale</div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 48 48" fill="none" class="card-logo">
                    <path d="M18.75 25.5C20.8211 25.5 22.5 27.1789 22.5 29.25V48H18.75C8.39475 48 0 39.6053 0 29.25V25.5H18.75ZM48 48H25.5V29.25C25.5 27.1789 27.1789 25.5 29.25 25.5H48V48ZM22.5 18.75C22.5 20.8211 20.8211 22.5 18.75 22.5H0V18.75C0 8.39475 8.39475 0 18.75 0H22.5V18.75ZM29.25 0C39.6053 0 48 8.39475 48 18.75V22.5H29.25C27.1789 22.5 25.5 20.8211 25.5 18.75V0H29.25Z" fill="currentColor"></path>
                  </svg>
