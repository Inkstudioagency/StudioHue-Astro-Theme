---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
---
<Base page="contact" title="Contact" description="Start a project with StudioHue for branding, web design, Webflow development, UI/UX, or ongoing creative support. Tell us about your goals and vision.">
  <div class="page-wrapper">
    <div class="hero-area">
      <Header />
      <section class="section contact">
        <div class="section-gap bottom-6xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="inner-hero-header">
              <div class="inner-hero-left contact">
                <div class="badge">
                  <div class="badge-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon">
                      <rect x="5" width="2" height="12" fill="currentColor"></rect>
                      <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                      <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                      <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                    </svg></div>
                  <div class="badge-text">GET IN TOUCH</div>
                </div>
                <div class="hero-heading-wrap">
                  <h1 class="hero-heading">Let&#x27;s Create Something Exceptional Together</h1>
                </div>
                <div class="inner-summary-wrap">
                  <p class="inner-hero-summary">Whether you&#x27;re launching a new brand, redesigning your website, or looking for a long-term creative partner, we&#x27;d love to hear about your vision.</p>
                </div>
              </div>
              <div class="inner-hero-right contact">
                <a href="https://www.facebook.com/" target="_blank" class="contact-social-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none" class="contact-social-icon">
                    <path d="M12.0013 1.33301H10.0013C9.11725 1.33301 8.2694 1.6842 7.64428 2.30932C7.01916 2.93444 6.66797 3.78229 6.66797 4.66634V6.66634H4.66797V9.33301H6.66797V14.6663H9.33464V9.33301H11.3346L12.0013 6.66634H9.33464V4.66634C9.33464 4.48953 9.40487 4.31996 9.5299 4.19494C9.65492 4.06991 9.82449 3.99967 10.0013 3.99967H12.0013V1.33301Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="demo">#</div>
                </a>
                <a href="https://x.com/" target="_blank" class="contact-social-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none" class="contact-social-icon">
                    <path d="M2 14L7.03226 8.96774M14 2L8.96774 7.03226M7.03226 8.96774L10.6667 14H14L8.96774 7.03226L5.33333 2H2L7.03226 8.96774Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="demo">#</div>
                </a>
                <a href="https://www.instagram.com/" target="_blank" class="contact-social-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none" class="contact-social-icon">
                    <g clip-path="url(#clip0_10099_6700)">
                      <path d="M11.332 1.33301H4.66536C2.82442 1.33301 1.33203 2.82539 1.33203 4.66634V11.333C1.33203 13.174 2.82442 14.6663 4.66536 14.6663H11.332C13.173 14.6663 14.6654 13.174 14.6654 11.333V4.66634C14.6654 2.82539 13.173 1.33301 11.332 1.33301Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M10.6678 7.5802C10.75 8.13503 10.6553 8.70168 10.3969 9.19954C10.1386 9.69741 9.72987 10.1011 9.22886 10.3533C8.72784 10.6055 8.16007 10.6933 7.6063 10.6042C7.05252 10.515 6.54095 10.2536 6.14433 9.85698C5.74772 9.46036 5.48626 8.94878 5.39715 8.39501C5.30804 7.84124 5.39582 7.27346 5.64799 6.77245C5.90017 6.27144 6.3039 5.86269 6.80176 5.60436C7.29963 5.34603 7.86628 5.25126 8.42111 5.33353C8.98706 5.41746 9.51101 5.68118 9.91557 6.08574C10.3201 6.4903 10.5839 7.01425 10.6678 7.5802Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M11.668 4.33301H11.6746" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </g>
                    <defs>
                      <clipPath id="clip0_10099_6700">
                        <rect width="16" height="16" fill="currentColor"></rect>
                      </clipPath>
                    </defs>
                  </svg>
                  <div class="demo">#</div>
                </a>
                <a href="https://www.linkedin.com/" target="_blank" class="contact-social-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none" class="contact-social-icon">
                    <path d="M10.668 5.33301C11.7288 5.33301 12.7463 5.75444 13.4964 6.50458C14.2465 7.25473 14.668 8.27214 14.668 9.33301V13.9997H12.0013V9.33301C12.0013 8.97939 11.8608 8.64025 11.6108 8.3902C11.3607 8.14015 11.0216 7.99967 10.668 7.99967C10.3143 7.99967 9.97521 8.14015 9.72516 8.3902C9.47511 8.64025 9.33464 8.97939 9.33464 9.33301V13.9997H6.66797V9.33301C6.66797 8.27214 7.0894 7.25473 7.83954 6.50458C8.58969 5.75444 9.6071 5.33301 10.668 5.33301Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M3.9987 6H1.33203V14H3.9987V6Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M2.66536 3.99967C3.40174 3.99967 3.9987 3.40272 3.9987 2.66634C3.9987 1.92996 3.40174 1.33301 2.66536 1.33301C1.92898 1.33301 1.33203 1.92996 1.33203 2.66634C1.33203 3.40272 1.92898 3.99967 2.66536 3.99967Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="demo">#</div>
                </a>
              </div>
            </div>
            <div class="contact-devider-line"></div>
            <div class="w-layout-grid contact-grid">
              <div class="contact-left-main">
                <div class="contact-left">
                  <div class="contact-left-top">
                    <div class="contact-title">Reach Out Anytime</div>
                    <p class="inner-hero-summary">Choose the most convenient way to connect with our team. We typically respond within one business day.</p>
                  </div>
                  <div class="contact-info-wrap">
                    <div class="contact-info-top"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="contact-icon">
                        <g clip-path="url(#clip0_10099_6641)">
                          <path d="M3 7C3 6.46957 3.21071 5.96086 3.58579 5.58579C3.96086 5.21071 4.46957 5 5 5H19C19.5304 5 20.0391 5.21071 20.4142 5.58579C20.7893 5.96086 21 6.46957 21 7V17C21 17.5304 20.7893 18.0391 20.4142 18.4142C20.0391 18.7893 19.5304 19 19 19H5C4.46957 19 3.96086 18.7893 3.58579 18.4142C3.21071 18.0391 3 17.5304 3 17V7Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clipPath id="clip0_10099_6641">
                            <rect width="24" height="24" fill="currentColor"></rect>
                          </clipPath>
                        </defs>
                      </svg>
                      <div class="contact-text-wrap">
                        <div class="font-small">GENERAL ENQUIRIES</div>
                        <a href="mailto:hello@studiohue.studio" class="contact-link">hello@studiohue.studio</a>
                      </div>
                    </div>
                    <div class="contact-info-top"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="contact-icon">
                        <g clip-path="url(#clip0_10099_6641)">
                          <path d="M3 7C3 6.46957 3.21071 5.96086 3.58579 5.58579C3.96086 5.21071 4.46957 5 5 5H19C19.5304 5 20.0391 5.21071 20.4142 5.58579C20.7893 5.96086 21 6.46957 21 7V17C21 17.5304 20.7893 18.0391 20.4142 18.4142C20.0391 18.7893 19.5304 19 19 19H5C4.46957 19 3.96086 18.7893 3.58579 18.4142C3.21071 18.0391 3 17.5304 3 17V7Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clipPath id="clip0_10099_6641">
                            <rect width="24" height="24" fill="currentColor"></rect>
                          </clipPath>
                        </defs>
                      </svg>
                      <div class="contact-text-wrap">
                        <div class="font-small">PHONE</div>
                        <a href="tel:+61390000000" class="contact-link">+61 3 9000 0000</a>
                      </div>
                    </div>
                    <div class="contact-info-top"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="contact-icon">
                        <g clip-path="url(#clip0_10099_6674)">
                          <path d="M9 11C9 11.7956 9.31607 12.5587 9.87868 13.1213C10.4413 13.6839 11.2044 14 12 14C12.7956 14 13.5587 13.6839 14.1213 13.1213C14.6839 12.5587 15 11.7956 15 11C15 10.2044 14.6839 9.44129 14.1213 8.87868C13.5587 8.31607 12.7956 8 12 8C11.2044 8 10.4413 8.31607 9.87868 8.87868C9.31607 9.44129 9 10.2044 9 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M13.414 20.9002L17.657 16.6572C18.7758 15.5384 19.5377 14.1129 19.8463 12.5611C20.155 11.0092 19.9965 9.40071 19.391 7.93893C18.7855 6.47714 17.7601 5.22774 16.4445 4.3487C15.1289 3.46967 13.5822 3.00049 12 3.00049C10.4178 3.00049 8.87107 3.46967 7.55548 4.3487C6.2399 5.22774 5.21452 6.47714 4.60901 7.93893C4.00349 9.40071 3.84504 11.0092 4.15369 12.5611C4.46234 14.1129 5.22422 15.5384 6.343 16.6572L10.587 20.9002C10.962 21.2748 11.4704 21.4853 12.0005 21.4853C12.5306 21.4853 13.039 21.2748 13.414 20.9002Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clipPath id="clip0_10099_6674">
                            <rect width="24" height="24" fill="currentColor"></rect>
                          </clipPath>
                        </defs>
                      </svg>
                      <div class="contact-text-wrap">
                        <div class="font-small">STUDIO</div>
                        <div class="contact-location">350 High St, Hawthorn, Victoria 3144, Australia</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="contact-right">
                <div class="contact-form-main w-form">
                  <form id="wf-form-Contact-Form" name="wf-form-Contact-Form" data-name="Contact Form" method="get" class="form" data-wf-page-id="6aa8d94a34bbb99ae5520711" data-wf-element-id="dea03d22-2d22-4873-8e73-7d46eef567e2">
                    <div class="row">
                      <div class="group"><label for="name" class="label-text">YOUR NAME</label><input class="text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Transparent" type="text" id="name"></div>
                      <div class="group"><label for="Email" class="label-text">EMAIL</label><input class="text-field w-input" maxlength="256" name="Email" data-name="Email" placeholder="jane@company.com" type="email" id="Email" required=""></div>
                    </div>
                    <div class="row">
                      <div class="group"><label for="Phone" class="label-text">phone</label><input class="text-field w-input" maxlength="256" name="Phone" data-name="Phone" placeholder="+1 (000) 000-0000" type="tel" id="Phone" required=""></div>
                    </div>
                    <div class="row">
                      <div class="group"><label for="Email" class="label-text">COMPANY</label><input class="text-field w-input" maxlength="256" name="Company-name" data-name="Company name" placeholder="Company name" type="text" id="Company-name"></div>
                    </div>
                    <div class="row">
                      <div class="group"><label for="Email" class="label-text">COMPANY</label>
                        <div class="radio-btn-wrap"><label class="radio-button-field w-radio">
                            <div class="w-form-formradioinput w-form-formradioinput--inputType-custom radio-button w-radio-input"></div><input type="radio" data-name="Radio" id="Radio-3" name="Radio" style="opacity:0;position:absolute;z-index:-1" value="Radio"><span class="radio-button-text w-form-label">UP TO $10K</span>
                          </label><label class="radio-button-field w-radio">
                            <div class="w-form-formradioinput w-form-formradioinput--inputType-custom radio-button w-radio-input"></div><input type="radio" data-name="Radio" id="Radio-2" name="Radio" style="opacity:0;position:absolute;z-index:-1" value="Radio"><span class="radio-button-text w-form-label">$10-$20k</span>
                          </label><label class="radio-button-field w-radio">
                            <div class="w-form-formradioinput w-form-formradioinput--inputType-custom radio-button w-radio-input"></div><input type="radio" data-name="Radio" id="Radio-4" name="Radio" style="opacity:0;position:absolute;z-index:-1" value="Radio"><span class="radio-button-text w-form-label">$20-$50k</span>
                          </label><label class="radio-button-field w-radio">
                            <div class="w-form-formradioinput w-form-formradioinput--inputType-custom radio-button w-radio-input"></div><input type="radio" data-name="Radio" id="Radio" name="Radio" style="opacity:0;position:absolute;z-index:-1" value="Radio"><span class="radio-button-text w-form-label">$50-$100k</span>
                          </label><label class="radio-button-field w-radio">
                            <div class="w-form-formradioinput w-form-formradioinput--inputType-custom radio-button w-radio-input"></div><input type="radio" data-name="Radio" id="Radio-5" name="Radio" style="opacity:0;position:absolute;z-index:-1" value="Radio"><span class="radio-button-text w-form-label">&gt;$100k</span>
                          </label></div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="group"><label for="field" class="label-text">COMPANY</label><textarea placeholder="Example Text" maxlength="5000" id="field" name="field" data-name="Field" class="text-field message-area w-input"></textarea></div>
                    </div>
                    <div class="form-button-wrap"><input type="submit" data-wait="Please wait..." class="contact-submit-btn w-button" value="Send enquiry"></div>
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="error-message w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
    <div class="main">
      <Cta />
    </div>
    <Footer page="contact" />
  </div>
</Base>
