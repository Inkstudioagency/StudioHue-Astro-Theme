---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
---
<Base page="about" title="About" description="Meet StudioHue, a hands-on creative studio partnering with ambitious founders to build purposeful brands, digital experiences, and lasting business impact.">
  <div class="page-wrapper">
    <div class="hero-area">
      <Header />
      <section class="section">
        <div class="section-gap bottom-3xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="inner-hero-header">
              <div class="inner-hero-left">
                <div class="inner-badge">
                  <div class="badge-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon">
                      <rect x="5" width="2" height="12" fill="currentColor"></rect>
                      <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                      <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                      <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                    </svg></div>
                  <div class="badge-text">STUDIO</div>
                </div>
                <div class="hero-heading-wrap">
                  <h1 class="hero-heading">A small studio with big convictions.</h1>
                </div>
              </div>
              <div class="inner-hero-right">
                <p class="inner-hero-summary">StudioHue is a twelve-person studio partnering with founders who see design as a key advantage.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="inner-image-wrap"><img src="/images/Rectangle-28-9.webp" loading="lazy" sizes="(max-width: 2880px) 100vw, 2880px" srcset="/images/Rectangle-28-9-p-500.webp 500w, /images/Rectangle-28-9-p-800.webp 800w, /images/Rectangle-28-9-p-1080.webp 1080w, /images/Rectangle-28-9-p-1600.webp 1600w, /images/Rectangle-28-9-p-2000.webp 2000w, /images/Rectangle-28-9-p-2600.webp 2600w, /images/Rectangle-28-9.webp 2880w" alt="Person wearing shiny hooded jacket and virtual reality headset with colorful light reflections in background." class="inner-hero-image"></div>
      </section>
    </div>
    <div class="main">
      <section class="section">
        <div class="section-gap spaacer-6xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="our-approce-wrap">
              <div class="approach-badge">
                <div class="badge-icon-wrap brand-color"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon white">
                    <rect x="5" width="2" height="12" fill="currentColor"></rect>
                    <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                    <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                    <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                  </svg></div>
                <div class="badge-text brand-color">OUR APPROACH</div>
              </div>
              <div class="our-approch-right">
                <div class="approach-summary-wrap">
                  <p class="approach-title">We keep our team small so project leads stay hands-on—no handoffs or juniors learning on your dime. We focus on fewer, better-crafted projects with solid strategy and passion.</p>
                </div>
                <div class="counter-card-wrap">
                  <div class="about-single-stat-block">
                    <div data-counter="counter" class="statistics-number">10+</div>
                    <div class="font-regular secodary-black">Years in practice</div>
                  </div>
                  <div class="about-single-stat-block">
                    <div data-counter="counter" class="statistics-number">180+</div>
                    <div class="font-regular secodary-black">Projects delivered</div>
                  </div>
                  <div class="about-single-stat-block">
                    <div data-counter="counter" class="statistics-number">14</div>
                    <div class="font-regular secodary-black">Industry awards</div>
                  </div>
                  <div class="about-single-stat-block">
                    <div data-counter="counter" class="statistics-number">40+</div>
                    <div class="font-regular secodary-black">Clients worldwide</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="out-vision-wrap">
              <div class="vision-left">
                <p class="vision-text">Everything we create is built with long-term business growth in mind.</p>
              </div>
              <div class="vision-right">
                <div class="vision-content-wrap">
                  <div class="vision-info-group">
                    <div class="font-medium">Our Mission</div>
                    <div class="font-normal">To empower businesses through purposeful design, innovative digital experiences, and collaborative partnerships that create measurable impact.</div>
                  </div>
                  <div class="vision-info-group">
                    <div class="font-medium">Our Vision</div>
                    <div class="font-normal">Our goal is to become a globally recognized creative agency, celebrated for turning ambitious ideas into unforgettable digital brands that leave a lasting impact.</div>
                  </div>
                </div><img src="/images/Rectangle-29-3.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Rectangle-29-3-p-500.webp 500w, /images/Rectangle-29-3-p-800.webp 800w, /images/Rectangle-29-3-p-1080.webp 1080w, /images/Rectangle-29-3.webp 1265w" alt="Silhouetted person standing in glowing circular light patterns on a dark reflective floor with colorful hues." class="vision-img">
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section smoky-black">
        <div class="section-gap space-5xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-header">
              <div class="serction-header-left max-width-40">
                <div class="badge">
                  <div class="badge-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon">
                      <rect x="5" width="2" height="12" fill="currentColor"></rect>
                      <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                      <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                      <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                    </svg></div>
                  <div class="badge-text">OUR TEAM</div>
                </div>
                <h2 class="section-heading">Creative Thinkers. Strategic Problem Solvers.</h2>
              </div>
            </div>
            <div class="w-layout-grid team-grid">
              <div class="team-card"><img src="/images/Rectangle-30.webp" loading="lazy" sizes="100vw" srcset="/images/9dead468c3321f96daa9334ed456553d_Rectangle-30-p-500.webp 500w, /images/9dead468c3321f96daa9334ed456553d_Rectangle-30-p-800.webp 800w, /images/9dead468c3321f96daa9334ed456553d_Rectangle-30-p-1080.webp 1080w, /images/Rectangle-30.webp 1312w" alt="Man with light brown hair wearing a dark suit, white shirt, and patterned tie on a gray background." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
              <div class="team-card"><img src="/images/Rectangle-30-2.webp" loading="lazy" sizes="100vw" srcset="/images/b91aee142e284595e92f80801213926d_Rectangle-30-2-p-500.webp 500w, /images/b91aee142e284595e92f80801213926d_Rectangle-30-2-p-800.webp 800w, /images/b91aee142e284595e92f80801213926d_Rectangle-30-2-p-1080.webp 1080w, /images/Rectangle-30-2.webp 1312w" alt="Man with glasses and white shirt resting chin on hand looking up thoughtfully against plain background." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
              <div class="team-card"><img src="/images/Rectangle-30-1.webp" loading="lazy" sizes="100vw" srcset="/images/f51b4a6a93abadcfa6a37ce80fb71d44_Rectangle-30-1-p-500.webp 500w, /images/f51b4a6a93abadcfa6a37ce80fb71d44_Rectangle-30-1-p-800.webp 800w, /images/Rectangle-30-1.webp 875w" alt="Man with glasses and beard wearing tan jacket looking thoughtfully to the side against plain background." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
              <div class="team-card"><img src="/images/Rectangle-30-3.webp" loading="lazy" sizes="100vw" srcset="/images/10bc370944c9c2c801da9dca94209d17_Rectangle-30-3-p-500.webp 500w, /images/10bc370944c9c2c801da9dca94209d17_Rectangle-30-3-p-800.webp 800w, /images/10bc370944c9c2c801da9dca94209d17_Rectangle-30-3-p-1080.webp 1080w, /images/Rectangle-30-3.webp 1312w" alt="Young man with medium-length wavy hair, wearing round glasses, black beanie, and black sweatshirt." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
              <div class="team-card"><img src="/images/Rectangle-30-4.webp" loading="lazy" sizes="100vw" srcset="/images/25f522662b51ee8c12410f7f19cd1c56_Rectangle-30-4-p-500.webp 500w, /images/25f522662b51ee8c12410f7f19cd1c56_Rectangle-30-4-p-800.webp 800w, /images/25f522662b51ee8c12410f7f19cd1c56_Rectangle-30-4-p-1080.webp 1080w, /images/Rectangle-30-4.webp 1312w" alt="Young man with curly hair, black glasses, and a white t-shirt against a plain background." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
              <div class="team-card"><img src="/images/Rectangle-30-5.webp" loading="lazy" sizes="100vw" srcset="/images/506ff4ebba7929e049bf64225b0f438b_Rectangle-30-5-p-500.webp 500w, /images/506ff4ebba7929e049bf64225b0f438b_Rectangle-30-5-p-800.webp 800w, /images/506ff4ebba7929e049bf64225b0f438b_Rectangle-30-5-p-1080.webp 1080w, /images/Rectangle-30-5.webp 1312w" alt="Man with medium-length hair and glasses wearing a black shirt looking slightly upward." class="team-img">
                <div class="team-info-block">
                  <div class="font-large is-white">Olivia Carter</div>
                  <div class="font-regular tertiary">Founder &amp; Creative Director</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="section-gap spaacer-6xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="value-main">
              <div class="value-left">
                <div class="value-left-top">
                  <div class="about-badge">
                    <div class="badge-icon-wrap brand-color"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" class="badge-icon white">
                        <rect x="5" width="2" height="12" fill="currentColor"></rect>
                        <rect x="9.53564" y="1.05029" width="2" height="12" transform="rotate(45 9.53564 1.05029)" fill="currentColor"></rect>
                        <rect x="12" y="5" width="2" height="12" transform="rotate(90 12 5)" fill="currentColor"></rect>
                        <rect x="10.9497" y="9.53564" width="2" height="12" transform="rotate(135 10.9497 9.53564)" fill="currentColor"></rect>
                      </svg></div>
                    <div class="badge-text brand-color">OUR APPROACH</div>
                  </div>
                  <div class="value-heading-wrap">
                    <h2 class="section-heading black">The Basics Behind Every Project</h2>
                  </div>
                  <div class="value-summary-wrap">
                    <p class="font-regular black">Our core values influence how we think, collaborate, and deliver exceptional results consistently and effectively.</p>
                  </div>
                </div><img src="/images/Rectangle-37-2.webp" loading="lazy" sizes="100vw" srcset="/images/Rectangle-37-2-p-500.webp 500w, /images/Rectangle-37-2-p-800.webp 800w, /images/Rectangle-37-2-p-1080.webp 1080w, /images/Rectangle-37-2-p-1600.webp 1600w, /images/Rectangle-37-2-p-2000.webp 2000w, /images/Rectangle-37-2.webp 2148w" alt="Person writing in a notebook with a pen beside a glass of water on a white table in soft light." class="value-img">
              </div>
              <div class="value-right">
                <div class="value-card">
                  <div class="value-card-top">
                    <div class="font-large">Strategy first</div>
                    <div class="font-medium brand-color">01</div>
                  </div>
                  <div class="value-paragraph-wrap">
                    <p class="font-normal medium">Beautiful work without purpose is just decoration. We start by understanding the problem to create effective solutions.</p>
                  </div>
                </div>
                <div class="value-card">
                  <div class="value-card-top">
                    <div class="font-large">Craft always</div>
                    <div class="font-medium brand-color">02</div>
                  </div>
                  <div class="value-paragraph-wrap">
                    <p class="font-normal medium">Beautiful work without purpose is just decoration. We start by understanding the problem to create effective solutions.</p>
                  </div>
                </div>
                <div class="value-card">
                  <div class="value-card-top">
                    <div class="font-large">Honest partners</div>
                    <div class="font-medium brand-color">03</div>
                  </div>
                  <div class="value-paragraph-wrap">
                    <p class="font-normal medium">Beautiful work without purpose is just decoration. We start by understanding the problem to create effective solutions.</p>
                  </div>
                </div>
                <div class="value-card">
                  <div class="value-card-top">
                    <div class="font-large">Built to last</div>
                    <div class="font-medium brand-color">04</div>
                  </div>
                  <div class="value-paragraph-wrap">
                    <p class="font-normal medium">Beautiful work without purpose is just decoration. We start by understanding the problem to create effective solutions.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <Cta />
    </div>
    <Footer page="about" />
  </div>
</Base>
