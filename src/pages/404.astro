---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base page="notFound" title="Not Found" description="The page you’re looking for can’t be found. Return to StudioHue to explore our creative services, selected work, insights, and ways to get in touch.">
  <div class="page-wrapper">
    <div class="hero-area">
      <Header />
      <section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="not-found-content-block">
              <div class="not-found-text-block">
                <h1 class="not-found-text">4<span class="not-found-ht-text">0</span>4</h1>
                <h2 data-wf-target="[[[&quot;6aa8d94a34bbb99ae5520709&quot;,&quot;deb223b9-c449-3a7c-96aa-088f5d7901d4&quot;],[]]]" class="_404-heading">Page Not Found!</h2>
                <div class="_404 align-center">The page you are looking for doesn&#x27;t exist or has been moved</div>
              </div>
              <div class="not-found-button-block">
                <a href="/" data-wf--primary-button--variant="secondary" data-wf-component-id="fe6f4be6-50ca-05e1-38e9-9a6e9da8d773" data-wf-variant-state="4f7104bd-54b2-0f4b-648a-a9405bcf4a72" class="primary-button w-variant-4f7104bd-54b2-0f4b-648a-a9405bcf4a72 w-inline-block">
                  <div class="button-dot">
                    <div class="animated-dot w-variant-4f7104bd-54b2-0f4b-648a-a9405bcf4a72"></div>
                  </div>
                  <div class="button-text-wrap">
                    <div class="footer-link-text">Go To Home</div>
                    <div class="footer-link-text is-two">Go To Home</div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
    <Footer page="notFound" />
  </div>
</Base>
