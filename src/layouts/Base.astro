---
/**
 * Base layout – the <html> shell shared by every page.
 *
 * The theme is a 1:1 port of the StudioHue Webflow design, so the layout keeps the
 * interactions runtime (public/js/interactions.js) and its expectations intact:
 *   - `data-page-id` on <html> scopes that page's interaction timelines
 *   - the inline `w-mod-js` script must run synchronously in <head>
 *   - jQuery → interactions.js → GSAP (+SplitText, ScrollTrigger) → Lenis, in that order
 */
import config from '../config/config.json';
import SeoMeta from '../components/SeoMeta.astro';
import { pageEffects, type PageKey } from '../lib/page-effects';

import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/studiohue.webflow.css';
import '../styles/lenis.css';
import '../styles/theme.css';

interface Props {
  /** Which Webflow page definition to use (drives interactions + hidden-until-animated selectors). */
  page: PageKey;
  title?: string;
  description?: string;
  image?: string;
  rawTitle?: boolean;
}

const { page, title, description, image, rawTitle } = Astro.props;
const wf = pageEffects[page];
const { site, fonts } = config;
const hiddenCss = `html.w-mod-js:not(.w-mod-ix3) :is(${wf.hidden}) {visibility: hidden !important;}`;
---

<!doctype html>
<html data-page-id={wf.id} lang="en">
  <head>
    <meta charset="utf-8" />
    <SeoMeta title={title} description={description} image={image} rawTitle={rawTitle} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={hiddenCss}></style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript" define:vars={{ families: fonts.google_families }}>
      WebFont.load({ google: { families: families } });
    </script>
    <script is:inline type="text/javascript">
      !function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);
    </script>
    <link href={site.favicon} rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href={site.favicon_dark} rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href={site.favicon_48} rel="icon" type="image/png" sizes="48x48" />
    <link href={site.webclip_180} rel="apple-touch-icon" sizes="180x180" />
    <link href={site.webclip_192} rel="icon" type="image/png" sizes="192x192" />
    <link href={site.webclip} rel="icon" type="image/png" sizes="512x512" />
  </head>
  <body>
    <slot />
    <script is:inline src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/js/interactions.js" type="text/javascript"></script>
    <script is:inline src="/js/gsap.min.js" type="text/javascript"></script>
    <script is:inline src="/js/SplitText.min.js" type="text/javascript"></script>
    <script is:inline src="/js/ScrollTrigger.min.js" type="text/javascript"></script>
    <script is:inline src="/js/lenis.min.js"></script>
    <script is:inline src="/js/site.js"></script>
  </body>
</html>
