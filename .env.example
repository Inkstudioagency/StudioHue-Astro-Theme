# Strapi CMS (optional). When STRAPI_URL is set and reachable, the Services,
# Projects and Blog collections are fetched from Strapi at build time.
# Leave it empty (or offline) to use the bundled JSON content in src/data/.
STRAPI_URL=http://localhost:1337
# A Strapi API token with "Read" access (Settings → API Tokens). Not needed when
# the Public role has find/findOne permissions on the three collections.
STRAPI_TOKEN=
