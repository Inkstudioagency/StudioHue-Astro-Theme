---
/** Prev/next arrows + hidden nav dots for a Webflow slider (.w-slider). */
interface Props {
  /** Button class: work-slider-button (dark sections) or expertise-slide-button (light sections). */
  class?: string;
}
const { class: btn = 'work-slider-button' } = Astro.props;
---

<div class={`${btn} left w-slider-arrow-left`}><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="slider-button-arrow">
    <g clip-path="url(#clip0_10141_6986)">
      <path d="M16 10L4.33333 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M8.16699 6L4.16699 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M8.16699 14L4.16699 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </g>
    <defs>
      <clipPath id="clip0_10141_6986">
        <rect width="20" height="20" fill="currentColor"></rect>
      </clipPath>
    </defs>
  </svg></div>
<div class={`${btn} right w-slider-arrow-right`}><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="slider-button-arrow">
    <g clip-path="url(#clip0_10141_6979)">
      <path d="M4.1665 10H15.8332" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M12 14L16 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M12 6L16 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </g>
    <defs>
      <clipPath id="clip0_10141_6979">
        <rect width="20" height="20" fill="currentColor"></rect>
      </clipPath>
    </defs>
  </svg></div>
<div class="hide w-slider-nav w-round w-num"></div>
