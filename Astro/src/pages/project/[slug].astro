                </div>
                <div class="project-info-group">
                  <div class="font-small">SERVICES</div>
                  <div class="font-regular tertiary">{project.providedServices}</div>
                </div>
                <div class="project-info-group">
                  <div class="font-small">Location</div>
                  <div class="font-regular tertiary">{project.location}</div>
                </div>
              </div>
              <div class="project-summary-wrap">
                <p class="inner-hero-summary">{project.longSummary}</p>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-img-wrap"><img src={project.image} loading="lazy" alt="" sizes="100vw" class="inner-hero-image"></div>
      </section>
    </div>
    <div class="main">
      <section class="section">
        <div class="section-gap spaacer-6xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="w-layout-grid work-body-grid">
              <div class="project-left-main">
                <div class="project-left">
                  <div class="project-title-wrap">
                    <div class="project-left-title">Ready for the next step?</div>
                  </div>
