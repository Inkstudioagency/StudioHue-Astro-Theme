---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { project: entry.data } }));
}

const { project } = Astro.props;
// "Similar work": the next two projects in serial order, wrapping around.
const all = await getProjects();
const idx = all.findIndex((entry) => entry.data.slug === project.slug);
const others = [...all.slice(idx + 1), ...all.slice(0, idx)];
const similar = others.slice(0, 2);
---
<Base title={project.title} description={project.longSummary} image={project.image} rawTitle page="project">
  <div class="page-wrapper">
    <div class="hero-area">
      <Header />
      <section class="section">
        <div class="section-gap bottom-3xl">
          <div class="w-layout-blockcontainer container w-container">
