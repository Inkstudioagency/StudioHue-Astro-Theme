{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "Blog posts shown on the home page, /blog and /post/<slug>"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "summary": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "readTime": {
      "type": "string"
    },
    "detailsSummary": {
      "type": "text"
    },
    "details01": {
      "type": "richtext"
    },
    "details02": {
      "type": "richtext"
    },
    "quoteLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "quoteText": {
      "type": "text"
    },
    "altText": {
      "type": "string"
    }
  }
}
